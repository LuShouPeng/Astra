{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal desktop permissions for workspace selection and recent metadata.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "notification:default",
    "store:default",
    "opener:allow-open-path"
  ]
}
